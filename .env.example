# 从 https://my.telegram.org 的 API development tools 获取
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_with_your_telegram_api_hash

# 不使用代理时保持为空。
# 当前验证工具支持 socks5、socks4、http。
TELEGRAM_PROXY_TYPE=
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=
TELEGRAM_PROXY_USERNAME=
TELEGRAM_PROXY_PASSWORD=

# MySQL。密码仅放在本机 .env，不提交源码。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=tg_backup
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=tg_backup
DATABASE_POOL_SIZE=15
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=10
SLOW_REQUEST_LOG_SECONDS=0.5

# 开发环境可保持 false；HTTPS 部署时必须设为 true。
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173
SESSION_DAYS=30
AUTH_LOGIN_ATTEMPTS_PER_ACCOUNT=5
AUTH_LOGIN_ATTEMPTS_PER_IP=30
AUTH_LOGIN_WINDOW_SECONDS=300

# 备份任务。执行时间统一使用服务器操作系统时区。
BACKUP_BATCH_SIZE=100
BACKUP_MESSAGE_RETRIES=3
BACKUP_MEDIA_TIMEOUT_SECONDS=60
TELEGRAM_MEDIA_PARALLEL_CONNECTIONS_REGULAR=3
TELEGRAM_MEDIA_PARALLEL_CONNECTIONS_PREMIUM=6
TELEGRAM_MEDIA_PARALLEL_THRESHOLD_BYTES=8388608
TELEGRAM_MEDIA_REQUEST_SIZE_BYTES=524288
BACKUP_SCHEDULER_INTERVAL_SECONDS=20
HISTORY_UPDATE_BATCH_SIZE=100
HISTORY_UPDATE_MAX_MESSAGES_PER_RUN=1000

# 每个账号只创建一个常驻 TelegramClient。并发数限制不同会话同时占用账号的任务数。
TELEGRAM_ACCOUNT_OPERATION_CONCURRENCY=3
TELEGRAM_RUNTIME_READY_TIMEOUT_SECONDS=45
TELEGRAM_DIALOG_REFRESH_SECONDS=900
TELEGRAM_DIALOG_REFRESH_LIMIT=500
TELEGRAM_ENTITY_REFRESH_INTERVAL_SECONDS=15
TELEGRAM_ENTITY_PROFILE_TTL_HOURS=24
TELEGRAM_ENTITY_COLD_PROFILE_TTL_HOURS=168
TELEGRAM_ENTITY_WORKER_LEASE_SECONDS=300
TELEGRAM_ENTITY_WORKER_CONCURRENCY=3
TELEGRAM_ENTITY_JOB_PAUSE_SECONDS=0.08
OVERVIEW_CACHE_SECONDS=10

# 媒体预览图由 FFmpeg 按需生成并缓存在 data/previews。
FFMPEG_PATH=ffmpeg
MEDIA_PREVIEW_MAX_WIDTH=640
MEDIA_PREVIEW_TIMEOUT_SECONDS=20
MEDIA_PREVIEW_WORKER_COUNT=2
MEDIA_PREVIEW_QUEUE_SIZE=256
CUSTOM_EMOJI_DOWNLOAD_CONCURRENCY=3
CUSTOM_EMOJI_DOWNLOAD_TIMEOUT_SECONDS=45
